{
  "name": "house-renting-monorepo",
  "version": "1.0.0",
  "description": "Smart House & Apartment Property Management Application Monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json}\""
  },
  "devDependencies": {
    "prettier": "^3.1.1",
    "turbo": "^2.4.4"
  }
}
